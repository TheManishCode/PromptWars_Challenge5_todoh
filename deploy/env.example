# Copy to deploy/.env and fill in. Never commit the real file. Every value here is a placeholder.
EVENTMATE_SECRET=change-me-to-40-random-characters-or-more
EVENTMATE_PUBLIC_URL=https://todoh.example.com
# the public name, plus "todoh": the name Prometheus uses on the compose network (without it the scrape gets a 400)
EVENTMATE_ALLOWED_HOSTS=todoh.example.com,todoh
EVENTMATE_TRUSTED_PROXY=172.16.0.0/12
EVENTMATE_OWNER_TOKEN=change-me-at-least-16-chars
EVENTMATE_WEB_TOKEN=
EVENTMATE_ENABLE_LLM=0
# Optional tracing of the assistant to Langfuse (masked questions and answers leave the machine). All three or none; the host must be https or loopback.
# Without these three lines a container exports nothing, even if your development machine does.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Optional (mail): the spam folder to look in, read-only, for replies from vendors we wrote to. Empty = not looked at.
EVENTMATE_IMAP_SPAM_FOLDER=
# Mail sign-in: "password" (default, an app password in EVENTMATE_SMTP_PASSWORD) or "oauth2" (Google OAuth, SASL XOAUTH2). docs/EMAIL_SETUP.md has the steps.
EVENTMATE_MAIL_AUTH=
# For oauth2 only: the OAuth client ID and secret and the refresh token of the dedicated mailbox. Secrets: never commit, never paste into chat.
EVENTMATE_GMAIL_CLIENT_ID=
EVENTMATE_GMAIL_CLIENT_SECRET=
EVENTMATE_GMAIL_REFRESH_TOKEN=
