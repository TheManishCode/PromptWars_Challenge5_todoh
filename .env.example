# Copy to .env (git-ignored), fill in, then: chmod 600 .env
# Format: NAME=value, no spaces around '='. Only names listed in eventmate/env.py are read; values already in your shell win.
OPENWEATHER_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# EVENTMATE_ENABLE_LLM=0   (switches models off)
# GOOGLE_PLACES_API_KEY=
# BRAVE_SEARCH_API_KEY=
# FOURSQUARE_API_KEY=
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# EVENTMATE_OVERPASS_URL=
# Vendor conversations (ADR-042). Email: any SMTP/IMAP mailbox you own (Gmail needs an app password). Use a mailbox meant for this, not your main one.
# EVENTMATE_SMTP_HOST=smtp.gmail.com
# EVENTMATE_SMTP_PORT=465            (465 = TLS from the start; any other port uses STARTTLS)
# EVENTMATE_SMTP_USER=you@example.com
# EVENTMATE_SMTP_PASSWORD=
# EVENTMATE_MAIL_FROM=you@example.com   (defaults to the user)
# EVENTMATE_IMAP_HOST=imap.gmail.com
# EVENTMATE_IMAP_PORT=993
# Optional: the name of the mailbox's spam folder (Gmail: [Gmail]/Spam). Replies from addresses we wrote to that land there are shown to you, read-only, and never filed or acted on. Empty = not looked at.
EVENTMATE_IMAP_SPAM_FOLDER=
# Mail sign-in: "password" (default, an app password in EVENTMATE_SMTP_PASSWORD) or "oauth2" (Google OAuth, SASL XOAUTH2). docs/EMAIL_SETUP.md has the steps.
EVENTMATE_MAIL_AUTH=
# For oauth2 only: the OAuth client ID and secret and the refresh token of the dedicated mailbox. Secrets: never commit, never paste into chat.
EVENTMATE_GMAIL_CLIENT_ID=
EVENTMATE_GMAIL_CLIENT_SECRET=
EVENTMATE_GMAIL_REFRESH_TOKEN=
# WhatsApp: a self-hosted WAHA gateway (docker run -p 3000:3000 devlikeapro/waha), then scan its QR with the phone.
# EVENTMATE_WAHA_URL=http://localhost:3000
# EVENTMATE_WAHA_API_KEY=
# EVENTMATE_WAHA_SESSION=default
# EVENTMATE_POLL_SECONDS=60            (how often the agent sends approved messages and reads replies; 0 turns the loop off)
# EVENTMATE_COMMUNITY_PROFILES=   (path to a community profiles JSON; default eventmate/data/community_profiles.json)
